<div class="home-header">
    {{#if search}}
        <h1>You are searching for: <span>{{search}}</span></h1>
        {{#if toughtsQty}}
            <p>There were found <span>{{toughtsQty}}</span> toughts.</p>
        {{else}}
            <p>No toughts found that contain the term <span>{{search}}</span>.</p>
        {{/if}}
    {{else}}
        <h1>Discover some of our <span>Toughts</span></h1>
    {{/if}}
    <form action="/" method="GET">
        <input type="text" name="search" placeholder="Searching for something?">
        <input type="submit" class="btn" value="Search">
    </form>
    <div class="order-container">
        <span>Order by:</span>
        <form action="/" method="GET">
            <input type="hidden" name="search" value="{{this.search}}">
            <input type="hidden" name="order" value="new">
            <button type="submit"><i class="bi bi-arrow-up"></i></button>
        </form>
        <form action="/" method="GET">
            <input type="hidden" name="search" value="{{this.search}}">
            <input type="hidden" name="order" value="old">
            <button type="submit"><i class="bi bi-arrow-down"></i></button>
        </form>
        <a href="/">Clear filter</a>
    </div>
</div>
<div class="toughts-container">
    {{#each toughts}}
        <figure>
            <blockquote>
                "{{this.title}}"
            </blockquote>
            <figcaption>by <span>{{this.User.name}}</span></figcaption>
        </figure>
    {{/each}}
</div>