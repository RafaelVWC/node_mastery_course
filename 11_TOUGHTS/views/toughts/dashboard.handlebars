<div class="dashboard">
    <div class="title-container">
        <h2>Dashboard</h2>
        <a href="/toughts/add" class="btn">Create Toughts</a>
    </div>
    <h3>Your Toughts</h3>
    <ul>
        {{#each toughts}}
            <li>
               <span class="label">{{this.title}}</span>
               <span class="actions">
                    <a href="/toughts/edit/{{this.id}}" class="btn">Edit</a>
                    <form action="/toughts/remove" method="POST">
                        <input type="hidden" name="id" value="{{this.id}}">
                        <input type="submit" value="Delete" class="btn">      
                    </form>
               </span>
            </li>
        {{/each}}
    </ul>
    {{#if emptyToughts}}
        <p>There are no toughts made by you, start creating them <a href="/toughts/add">here</a></p>
    {{/if}}
</div>