<div id="book-page">
    <a href="/books">Voltar</a>
    <div class="container">
        <h1>{{book.title}}</h1>
        <p>Este livro tem {{book.page}} páginas.</p>
        <div class="actions">
            <a href="/books/edit/{{book.id}}">Editar</a>
            <form action="/book/remove/{{book.id}}" method="POST">
            <input type="submit" value="Remover">
        </div>
        </div>
    </div>
</div>